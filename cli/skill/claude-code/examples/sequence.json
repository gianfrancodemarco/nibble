{
  "kind": "sequence",
  "title": "One upload, resize off the request path",
  "actors": [
    { "id": "client", "label": "browser" },
    { "id": "api", "label": "upload-api" },
    { "id": "queue", "label": "resize queue" },
    { "id": "worker", "label": "resize-worker" },
    { "id": "s3", "label": "object store" }
  ],
  "steps": [
    { "id": "s1", "from": "client", "to": "api", "label": "POST /images (4 MB)", "kind": "call" },
    { "id": "s2", "from": "api", "to": "client", "label": "413", "kind": "return", "alt": "over 25 MB" },
    { "id": "s3", "from": "api", "to": "s3", "label": "PUT original", "kind": "call" },
    { "id": "s4", "from": "api", "to": "queue", "label": "enqueue {id, sizes}", "kind": "async" },
    { "id": "s5", "from": "api", "to": "client", "label": "201 — thumbnail URLs promised", "kind": "return" },
    { "id": "s6", "from": "worker", "to": "queue", "label": "claim job", "kind": "call" },
    { "id": "s7", "from": "worker", "to": "s3", "label": "PUT 3 sizes", "kind": "call" }
  ]
}
