{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gianfrancodemarco/nibble/main/protocol/schemas/sequence.schema.json",
  "title": "nibble visual: sequence",
  "type": "object",
  "required": ["kind", "title", "actors", "steps"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "sequence" },
    "title": { "type": "string", "minLength": 1 },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "to", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "label": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["call", "return", "async"] },
          "alt": { "type": "string" }
        }
      }
    }
  }
}
